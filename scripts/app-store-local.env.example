# Apple Team API key: Users and Access > Integrations > App Store Connect API > Team Keys.
# For certificate creation, use a team key with Admin access.
# Key ID: 10 characters. If already downloaded, it is part of AuthKey_XXXXXXXXXX.p8.
APP_STORE_CONNECT_KEY_IDENTIFIER=
# Issuer ID: the UUID shown on the Team Keys page, not the Apple Team ID.
APP_STORE_CONNECT_ISSUER_ID=
# Absolute path to the downloaded Team API .p8 file. Never paste its contents.
APP_STORE_CONNECT_PRIVATE_KEY_FILE=
